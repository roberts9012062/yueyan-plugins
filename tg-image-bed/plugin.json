{
  "id": "tg-image-bed",
  "name": "TG图床",
  "version": "0.4.2",
  "category": "enhancement",
  "price": 0,
  "installs": 0,
  "official": true,
  "description": "Telegram 频道图床：图片上传直达 TG（Bot API 保原图），自备反代 Worker 访问，后台图库管理与 Markdown 插图。",
  "capabilities": [
    "settings",
    "api",
    "admin.page"
  ],
  "open_endpoints": [
    {
      "endpoint": "tg-image-bed.upload",
      "method": "POST",
      "path": "/api/v1/open/plugins/tg-image-bed/upload",
      "name": "上传图片",
      "description": "上传图片到 Telegram 频道图床（原图保真），返回公开访问 URL 与 Markdown。需安装并启用「TG图床」插件并完成 Bot 配对",
      "params": [
        {
          "name": "filename",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "原始文件名（含扩展名，仅支持 jpg/jpeg/png/gif/webp）"
        },
        {
          "name": "mime",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "MIME 类型（如 image/png）"
        },
        {
          "name": "content_b64",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "图片内容 base64（单图 ≤ 20MB）"
        }
      ]
    },
    {
      "endpoint": "tg-image-bed.list",
      "method": "POST",
      "path": "/api/v1/open/plugins/tg-image-bed/list",
      "name": "图库列表",
      "description": "分页查询上传历史（新在前，每页 60 条，含公开 URL 与 Markdown）。需安装并启用「TG图床」插件",
      "params": [
        {
          "name": "cursor",
          "type": "string",
          "location": "body",
          "required": false,
          "description": "分页游标（首页留空；响应 cursor 非空表示还有下一页）"
        }
      ]
    }
  ],
  "storage_provider": true,
  "storage_raw_upload": true,
  "repo_url": "https://github.com/roberts9012062/yueyan-plugins",
  "core_version": ">=0.1.0",
  "nav": {
    "href": "/admin/plugin-pages/tg-image-bed/library",
    "label": "TG图床",
    "icon": "media"
  },
  "settings_schema": [
    {
      "key": "tg_bot_token",
      "label": "Bot Token（@BotFather 创建，如 123456:AAxxx）",
      "type": "text",
      "default": ""
    },
    {
      "key": "tg_chat_id",
      "label": "频道/群 Chat ID（如 -1001234567890 或 @channel）",
      "type": "text",
      "default": ""
    },
    {
      "key": "proxy_base",
      "label": "反代 Worker 地址（如 https://img.example.com）",
      "type": "text",
      "default": ""
    },
    {
      "key": "send_mode",
      "label": "发送模式（document=原图保真 / photo=TG 压缩）",
      "type": "select",
      "default": "document",
      "options": [
        "document",
        "photo"
      ]
    },
    {
      "key": "api_proxy",
      "label": "TG API 代理（服务器在大陆时填，如 http://127.0.0.1:7890；留空直连）",
      "type": "text",
      "default": ""
    }
  ],
  "assets": {
    "pattern": "{id}-{version}-{os}-{arch}.bpk",
    "sha256_by_platform": {
      "linux-arm64": "62e8aeb610c83120989c218bbd70d33bc4e0cabbfd63e918a76bc519b8d94b71",
      "windows-amd64": "46bdd2e97c2e60c84066b442c1018be48de6ee21c3dccb17264df53623b282cd"
    }
  }
}
