{
  "id": "nav-links",
  "name": "精品导航",
  "version": "1.3.18",
  "category": "enhancement",
  "price": 0,
  "installs": 0,
  "official": true,
  "description": "精品站点导航：后台收藏管理（分类/标签/AI 智能分类/自动抓取图标），前台公开导航页 + 私有导航页（仅自己可见/密码访问），开放接口供浏览器插件凭 Key 同步。",
  "capabilities": [
    "api",
    "frontend",
    "settings",
    "data.read",
    "admin.page",
    "site.page"
  ],
  "open_endpoints": [
    {
      "endpoint": "nav-links.private-list",
      "method": "GET",
      "path": "/api/v1/open/plugins/nav-links/private/links",
      "name": "私有导航列表",
      "description": "精品导航中可见性为「私有」的收藏站点（响应结构与开放导航列表一致，仅含私有条目）。需安装并启用「精品导航」插件",
      "plugin_method": "POST",
      "trusted_body": {
        "admin": true
      }
    },
    {
      "endpoint": "nav-links.private-config",
      "method": "GET",
      "path": "/api/v1/open/plugins/nav-links/private/config",
      "name": "私有导航设置读取",
      "description": "读取私有导航访问设置（访问方式/是否已设密码/私有页文案/私有条数），不含任何密码材料。需安装并启用「精品导航」插件"
    },
    {
      "endpoint": "nav-links.private-save",
      "method": "POST",
      "path": "/api/v1/open/plugins/nav-links/private/config",
      "name": "私有导航设置写入",
      "description": "修改私有导航访问设置（访问方式/访问密码/私有页文案）；password 留空=保持现有，修改后前台旧解锁自动失效。需安装并启用「精品导航」插件",
      "params": [
        {
          "name": "mode",
          "type": "string",
          "location": "body",
          "required": true,
          "description": "访问方式：self=仅自己可见 / password=密码访问"
        },
        {
          "name": "password",
          "type": "string",
          "location": "body",
          "required": false,
          "description": "访问密码（6-64 位；留空=保持现有；切 password 模式必须已设密码或本次提供）"
        },
        {
          "name": "title",
          "type": "string",
          "location": "body",
          "required": false,
          "description": "私有页标题（≤30 字）"
        },
        {
          "name": "subtitle",
          "type": "string",
          "location": "body",
          "required": false,
          "description": "私有页副标题（≤60 字）"
        }
      ]
    }
  ],
  "repo_url": "https://github.com/roberts9012062/yueyan-plugins",
  "core_version": ">=0.1.0",
  "nav": {
    "href": "/admin/plugin-pages/nav-links/admin",
    "label": "精品导航",
    "icon": "link"
  },
  "settings_schema": [
    {
      "key": "page_title",
      "label": "前台页面标题",
      "type": "text",
      "default": "精品导航"
    },
    {
      "key": "page_subtitle",
      "label": "前台页面副标题",
      "type": "text",
      "default": "收藏的优质站点"
    },
    {
      "key": "open_new_tab",
      "label": "新窗口打开站点",
      "type": "switch",
      "default": "on"
    }
  ],
  "assets": {
    "pattern": "{id}-{version}-{os}-{arch}.bpk",
    "sha256": "ab9a00f4c7ec1c49abd1a4fe09b68f603a41af62f2e5affbaaad2fe9260e85b8",
    "sha256_by_platform": {
      "windows-amd64": "ab9a00f4c7ec1c49abd1a4fe09b68f603a41af62f2e5affbaaad2fe9260e85b8",
      "linux-arm64": "46e92dd69f89658e2404dad331904595a74df5f5bc44da9e824c51e7e32e419f"
    }
  }
}
