{
  "id": "image-cdn",
  "name": "CF图床",
  "version": "2.1.0",
  "category": "performance",
  "price": 0,
  "installs": 9600,
  "official": true,
  "description": "媒体上传直达 Cloudflare R2：配对即用、服务端压缩、后台图片管理与发帖图库联动。免费。",
  "capabilities": [
    "settings",
    "api",
    "admin.page"
  ],
  "repo_url": "https://github.com/roberts9012062/yueyan-plugins",
  "core_version": ">=0.1.0",
  "nav": {
    "href": "/admin/plugin-pages/image-cdn/library",
    "label": "CF图床",
    "icon": "media"
  },
  "settings_schema": [
    {
      "key": "workers_url",
      "label": "Workers URL（如 https://imgs.example.com）",
      "type": "text",
      "default": ""
    },
    {
      "key": "api_key",
      "label": "API Key（wrangler secret put API_KEY 设置的值）",
      "type": "text",
      "default": ""
    },
    {
      "key": "compress_enabled",
      "label": "服务端压缩（JPEG 质量/边长缩放；已达标的自动跳过）",
      "type": "switch",
      "default": "on"
    },
    {
      "key": "compress_quality",
      "label": "JPEG 压缩质量（30-95）",
      "type": "text",
      "default": "80"
    },
    {
      "key": "max_dimension",
      "label": "最大边长像素（超出等比缩小；0=不缩放）",
      "type": "text",
      "default": "1920"
    }
  ],
  "assets": {
    "sha256_by_platform": {
      "linux-arm64": "a458d6a27ea4a050b5a8a2591599cf766912279bddd0135323487c601768d3ae"
    },
    "pattern": "{id}-{version}-{os}-{arch}.bpk"
  }
}
